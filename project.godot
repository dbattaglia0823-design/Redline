; Godot 4 project
config_version=5

[application]
config/name="REDLINE // Street Division"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A paddle-shift drag racing prototype."

[physics]
common/physics_ticks_per_second=120

[display]
window/size/viewport_width=1200
window/size/viewport_height=760
window/size/window_width_override=1200
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.06, 1)

[audio]
driver/mix_rate=22050

[input_devices]
pointing/emulate_mouse_from_touch=false
